{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "GPU Utilization %",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "meeting_gpu_utilization_percent",
          "legendFormat": "{{gpu_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100},
        "overrides": []
      }
    },
    {
      "title": "VRAM Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "meeting_gpu_vram_used_bytes",
          "legendFormat": "used {{gpu_id}}"
        },
        {
          "expr": "meeting_gpu_vram_total_bytes",
          "legendFormat": "total {{gpu_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes"},
        "overrides": []
      }
    },
    {
      "title": "Model Loading Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "meeting_gpu_model_loaded",
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"thresholds": {"steps": [{"value": 0, "color": "red"}, {"value": 1, "color": "green"}]}},
        "overrides": []
      }
    },
    {
      "title": "OOM Count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
      "targets": [
        {
          "expr": "sum(meeting_gpu_oom_total) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {"thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 1, "color": "red"}]}},
        "overrides": []
      }
    },
    {
      "title": "Actor Backlog",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "meeting_gpu_actor_backlog",
          "legendFormat": "{{actor_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "VRAM Usage %",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "avg(meeting_gpu_vram_used_bytes / meeting_gpu_vram_total_bytes * 100)"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}]}},
        "overrides": []
      }
    },
    {
      "title": "OOM Events over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 12},
      "targets": [
        {
          "expr": "sum(rate(meeting_gpu_oom_total[$__rate_interval])) by (gpu_id)",
          "legendFormat": "{{gpu_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      }
    },
    {
      "title": "Model Load/Unload Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "sum(rate(meeting_gpu_model_load_total[$__rate_interval])) by (model_name, action)",
          "legendFormat": "{{action}} {{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      }
    },
    {
      "title": "Actor Throughput",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {
          "expr": "sum(rate(meeting_gpu_actor_completed_total[$__rate_interval])) by (actor_type)",
          "legendFormat": "{{actor_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["meeting", "ai-worker", "gpu"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "Prometheus", "value": "prometheus"},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "auto": true,
        "auto_count": 30,
        "auto_min": "10s",
        "current": {"selected": true, "text": "auto", "value": "$__auto_interval_interval"},
        "hide": 2,
        "name": "interval",
        "options": [],
        "query": "1m,5m,10m,30m,1h",
        "type": "interval"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "utc",
  "title": "AI Worker GPU",
  "uid": "ai-worker-gpu",
  "version": 1,
  "weekStart": ""
}
{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "QPS (Requests per Second)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(meeting_api_http_requests_total[$__rate_interval])) by (method, handler)",
          "legendFormat": "{{method}} {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      }
    },
    {
      "title": "5xx Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(meeting_api_http_requests_total{status_code=~\"5..\"}[$__rate_interval])) / sum(rate(meeting_api_http_requests_total[$__rate_interval]))",
          "legendFormat": "5xx rate"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1},
        "overrides": []
      }
    },
    {
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(meeting_api_http_request_duration_seconds_bucket[$__rate_interval])) by (le, handler))",
          "legendFormat": "p50 {{handler}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(meeting_api_http_request_duration_seconds_bucket[$__rate_interval])) by (le, handler))",
          "legendFormat": "p95 {{handler}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(meeting_api_http_request_duration_seconds_bucket[$__rate_interval])) by (le, handler))",
          "legendFormat": "p99 {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      }
    },
    {
      "title": "Controller Error Codes TopN",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "topk(10, sum(rate(meeting_api_http_requests_total{status_code!~\"2..\"}[$__rate_interval])) by (handler, status_code))",
          "legendFormat": "{{handler}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      }
    },
    {
      "title": "HikariCP Active Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "meeting_hikaricp_connections_active",
          "legendFormat": "active"
        },
        {
          "expr": "meeting_hikaricp_connections_max",
          "legendFormat": "max"
        },
        {
          "expr": "meeting_hikaricp_connections_idle",
          "legendFormat": "idle"
        },
        {
          "expr": "meeting_hikaricp_connections_pending",
          "legendFormat": "pending"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "HikariCP Connection Usage %",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [
        {
          "expr": "meeting_hikaricp_connections_active / meeting_hikaricp_connections_max * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}]}}
      }
    },
    {
      "title": "HikariCP Acquisition Time p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(meeting_hikaricp_connection_acquisition_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["meeting", "api"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "Prometheus", "value": "prometheus"},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "auto": true,
        "auto_count": 30,
        "auto_min": "10s",
        "current": {"selected": true, "text": "auto", "value": "$__auto_interval_interval"},
        "hide": 2,
        "name": "interval",
        "options": [],
        "query": "1m,5m,10m,30m,1h",
        "type": "interval"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "utc",
  "title": "Meeting API Overview",
  "uid": "meeting-api-overview",
  "version": 1,
  "weekStart": ""
}
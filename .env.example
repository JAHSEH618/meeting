# ──────────────────────────────────────────────────────────────────────────────
# 本地会议智能系统 · 环境变量占位
# 用法：cp .env.example .env && 按需修改
# ──────────────────────────────────────────────────────────────────────────────

# ── Meeting API 多租户调度 ────────────────────────────────────────
# 所有后台调度器（outbox publisher、lease scanner、deletion runner、
# break-glass scanner）共享的活跃租户列表 CSV。也是登录默认租户。
# prod 必须显式列出至少一个真实租户，否则 meeting-api 启动失败
# (ProdProfileValidator)。
MEETING_TENANTS_ACTIVE=tenant_default

# ── Meeting API 鉴权 ──────────────────────────────────────────────
# 鉴权实现：dev/test 用 in-memory（admin/admin123 → tenant_default）；
# prod 必须切换到真实实现（jwt/oidc/jdbc），否则启动失败。
MEETING_AUTH_MODE=in-memory

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=meeting
POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting_dev
POSTGRES_PORT=5432

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# local definitions.json seeds this user; update the definitions password hash too
# if you change these credentials.
RABBITMQ_USER=meeting
RABBITMQ_PASS=meeting_dev
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── Vault (本地开发) ─────────────────────────────────────────────────
VAULT_DEV_ROOT_TOKEN=meeting-dev-root-token
VAULT_PORT=8200

# ── DashScope (第三方 LLM) ───────────────────────────────────────────
DASHSCOPE_API_KEY=sk-replace-with-real-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Callback HMAC (meeting-api ↔ ai-worker 双向鉴权) ─────────────────────────
# AI_WORKER_CALLBACK_HMAC_SECRET: ai-worker → Java callback (outbound)
# ⚠️ 必须与 AI_WORKER_INTERNAL_API_HMAC_SECRET 不同，永不复用
AI_WORKER_CALLBACK_HMAC_SECRET=change-me-callback-secret-32bytes
# AI_WORKER_INTERNAL_API_HMAC_SECRET: Java → ai-worker internal API (inbound)
# ⚠️ 必须与 AI_WORKER_CALLBACK_HMAC_SECRET 不同，永不复用
AI_WORKER_INTERNAL_API_HMAC_SECRET=change-me-internal-secret-32bytes

# ── Chunk Strategy ───────────────────────────────────────────────────────────
CHUNK_STRATEGY_VERSION=v1

# ── Storage ──────────────────────────────────────────────────────────────────
# STORAGE_TYPE: oss | tos —— 应用只实现了这两种对象存储网关
# （AliyunOssObjectStorageGateway / VolcengineTosObjectStorageGateway）。
# 本地 compose 不内置 MinIO。下面给出的是 TOS_* 占位，所以默认用 tos；
# 若要走 oss，请改 STORAGE_TYPE=oss 并补 OSS_ENDPOINT / OSS_REGION /
# OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET（compose 读的是这四个 OSS_* 变量）。
STORAGE_TYPE=tos
# 逻辑桶名（所有后端共用，控制台需提前建好这三个）
STORAGE_BUCKET_AUDIO=meeting-audio-auska
STORAGE_BUCKET_ARTIFACTS=meeting-artifacts
STORAGE_BUCKET_EXPORTS=meeting-exports
# 火山引擎 TOS（STORAGE_TYPE=tos 时必填）
# TOS_ENDPOINT 示例：https://tos-cn-beijing.volces.com
TOS_ENDPOINT=
TOS_REGION=cn-beijing
TOS_ACCESS_KEY_ID=
TOS_ACCESS_KEY_SECRET=

# ── AI Worker ────────────────────────────────────────────────────────────────
# Java → ai-worker 同步调用（RAG rerank）
AI_WORKER_BASE_URL=http://localhost:8090
# 入站 internal-API 防重放 nonce 的共享存储。多副本部署必须设为共享 Redis，
# 否则重放可绕到另一个 pod；不设则退化为单进程内存缓存（仅单副本安全）。
# workstation profile 的 compose 已内置 nonce-redis 服务作为默认值。
AI_WORKER_NONCE_REDIS_URL=redis://nonce-redis:6379/0
# ai-worker → Java 回调
AI_WORKER_MEETING_API_BASE_URL=http://localhost:8080
# AI Worker 存储后端（local | oss）。生产切换到 oss 时必须填下面四个变量，
# 且 RAM 子账号只能授予 oss:GetObject + oss:HeadObject（writes 由 Java 完成）。
AI_WORKER_STORAGE_BACKEND=local
AI_WORKER_TOS_ENDPOINT=
AI_WORKER_TOS_REGION=cn-beijing
AI_WORKER_TOS_ACCESS_KEY_ID=
AI_WORKER_TOS_ACCESS_KEY_SECRET=

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASS=admin
GRAFANA_PORT=3000

# ── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

{
  "name": "@meeting/meeting-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "codegen": "openapi-typescript ../../packages/meeting-contracts/openapi/public-api.yaml -o src/shared/api/types.gen.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^24.1.0",
    "msw": "^2.4.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting.local/schemas/processing-task-message.schema.json",
  "title": "ProcessingTaskMessage",
  "type": "object",
  "required": [
    "taskId",
    "taskType",
    "tenantId",
    "attemptNo",
    "pipelineSteps",
    "expectedInputVersion",
    "options",
    "traceId"
  ],
  "properties": {
    "taskId": {"type": "string", "minLength": 1},
    "taskType": {
      "type": "string",
      "enum": [
        "MEETING_FULL_PIPELINE",
        "SPEAKER_ENROLLMENT",
        "TEXT_EMBEDDING",
        "RAG_REINDEX"
      ]
    },
    "tenantId": {"type": "string", "minLength": 1},
    "meetingId": {"type": ["string", "null"]},
    "documentId": {"type": ["string", "null"]},
    "speakerProfileId": {"type": ["string", "null"]},
    "speakerEnrollmentId": {"type": ["string", "null"]},
    "audioFileId": {"type": ["string", "null"]},
    "audioUri": {"type": ["string", "null"], "pattern": "^(tos://.+)?$"},
    "attemptNo": {"type": "integer", "minimum": 1},
    "pipelineSteps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "AUDIO_PREPROCESS",
          "ASR",
          "ALIGNMENT",
          "DIARIZATION",
          "SPEAKER_EMBEDDING",
          "SPEAKER_MATCHING",
          "TRANSCRIPT_MERGE",
          "RAG_INDEXING"
        ]
      }
    },
    "expectedInputVersion": {
      "type": "object",
      "required": ["chunkStrategyVersion"],
      "properties": {
        "transcriptVersion": {"type": ["integer", "null"], "minimum": 0},
        "minutesVersion": {"type": ["integer", "null"], "minimum": 0},
        "ragVersion": {"type": ["integer", "null"], "minimum": 0},
        "documentVersion": {"type": ["integer", "null"], "minimum": 1},
        "chunkStrategyVersion": {"type": "string", "minLength": 1},
        "embeddingModelVersion": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "language": {"type": ["string", "null"]},
    "channelMap": {
      "type": ["object", "null"],
      "properties": {
        "channelCount": {"type": "integer", "minimum": 1},
        "layout": {"type": "string"},
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "label"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "label": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "knownParticipants": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "participantDisplayNames": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "maxItems": 64,
      "default": [],
      "description": "Human-readable participant names for ASR hot-word biasing. knownParticipants stays personId-based for speaker-match authorization; this field is display-only context."
    },
    "minSpeakers": {"type": ["integer", "null"], "minimum": 1},
    "maxSpeakers": {"type": ["integer", "null"], "minimum": 1},
    "options": {
      "type": "object",
      "properties": {
        "enableAsr": {"type": "boolean", "default": true},
        "enableDiarization": {"type": "boolean", "default": true},
        "enableSpeakerRecognition": {"type": "boolean", "default": true},
        "enableRagIndexing": {"type": "boolean", "default": true},
        "enableAlignment": {"type": "boolean", "default": false},
        "exportFormat": {"type": ["string", "null"], "enum": ["MARKDOWN", "DOCX", "PDF", null]}
      },
      "additionalProperties": true
    },
    "traceId": {"type": "string", "minLength": 1},
    "createdAt": {"type": ["string", "null"], "format": "date-time"},
    "glossaryTerms": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "maxItems": 200,
      "default": [],
      "description": "Optional meeting-scoped glossary terms; worker feeds them into ASR hot-word biasing together with participantDisplayNames."
    },
    "referenceDocumentIds": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "maxItems": 32,
      "default": [],
      "description": "Optional list of attached REFERENCE document ids; worker may use for RAG context, Java side uses for prompt enrichment."
    },
    "controlFlags": {
      "type": ["object", "null"],
      "properties": {
        "holdAtWorkerPhase": {
          "type": "boolean",
          "default": false,
          "description": "Java-side routing flag. Worker MUST NOT branch on this — when true, Java's WorkerPhaseCompletedListener stops at WORKER_DAG_DONE awaiting an explicit resume-java-phase call."
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"taskType": {"const": "MEETING_FULL_PIPELINE"}}
      },
      "then": {
        "required": [
          "meetingId",
          "audioFileId",
          "audioUri",
          "language",
          "channelMap",
          "knownParticipants",
          "minSpeakers",
          "maxSpeakers"
        ],
        "properties": {
          "meetingId": {"type": "string", "minLength": 1},
          "audioFileId": {"type": "string", "minLength": 1},
          "audioUri": {"type": "string", "pattern": "^tos://.+"}
        }
      }
    },
    {
      "if": {
        "properties": {"taskType": {"const": "SPEAKER_ENROLLMENT"}}
      },
      "then": {
        "required": ["speakerProfileId", "speakerEnrollmentId", "audioFileId", "audioUri", "language"],
        "properties": {
          "speakerProfileId": {"type": "string", "minLength": 1},
          "speakerEnrollmentId": {"type": "string", "minLength": 1},
          "audioFileId": {"type": "string", "minLength": 1},
          "audioUri": {"type": "string", "pattern": "^tos://.+"}
        }
      }
    },
    {
      "if": {
        "properties": {"taskType": {"enum": ["TEXT_EMBEDDING", "RAG_REINDEX"]}}
      },
      "then": {
        "anyOf": [
          {
            "required": ["meetingId"],
            "properties": {
              "meetingId": {"type": "string", "minLength": 1}
            }
          },
          {
            "required": ["documentId"],
            "properties": {
              "documentId": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}
